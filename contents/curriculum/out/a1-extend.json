    "grammar": {
     "explanation": "Para hablar de gustos se usan like, love, enjoy, hate. Detrás puede ir una cosa o una actividad terminada en -ing.",
     "title": "Like, love, hate + sustantivo o verbo en -ing",
     "rules": [
      {
       "examples": [
        "I like music.",
        "She loves chocolate."
       ],
       "rule": "Verbo + sustantivo"
      },
      {
       "rule": "Verbo + actividad en -ing",
       "examples": [
        "I like reading.",
        "They enjoy swimming."
       ]
      },
      {
       "rule": "Con he / she lleva -s",
       "examples": [
        "He likes sports.",
        "She hates spiders."
       ]
      },
      {
       "rule": "Negativo: don't / doesn't like",
       "examples": [
        "I don't like cooking.",
        "He doesn't like horror movies."
       ]
      },
      {
       "rule": "Pregunta: Do you like...?",
       "examples": [
        "Do you like sports? — Yes, I do. / No, I don't."
       ]
      }
     ]
    }
   }
