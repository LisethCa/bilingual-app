    "grammar": {
     "title": "A, an y some con comida",
     "explanation": "Los alimentos que se pueden contar llevan 'a' o 'an' en singular. Los que no se pueden contar llevan 'some'.",
     "rules": [
      {
       "rule": "a + consonante",
       "examples": [
        "a banana",
        "a sandwich"
       ]
      },
      {
       "rule": "an + vocal",
       "examples": [
        "an apple",
        "an egg"
       ]
      },
      {
       "rule": "some + incontables (y plurales)",
       "examples": [
        "some water",
        "some bread",
        "some apples"
       ]
      },
      {
       "rule": "Los contables tienen plural con -s",
       "examples": [
        "one apple → two apples",
        "one egg → three eggs"
       ]
      },
      {
       "rule": "Los incontables no tienen plural ni 'a'",
       "examples": [
        "✅ some bread",
        "❌ a bread",
        "❌ breads"
       ]
      }
     ]
    },
